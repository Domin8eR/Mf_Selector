# ==============================================================
# AltStreet — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Only .env.example is committed.
# ==============================================================

# ---- PostgreSQL ----------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=altstreet
POSTGRES_USER=altstreet
POSTGRES_PASSWORD=change_me

# Full DSN used by SQLAlchemy (sync driver)
DATABASE_URL=postgresql://altstreet:change_me@localhost:5432/altstreet

# ---- Redis ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- MinIO / S3 (S3-compatible, use same interface in prod) --
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=altstreet
S3_SECRET_ACCESS_KEY=change_me
S3_BUCKET_NAME=altstreet-dev

# ---- Security / JWT ------------------------------------------
# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_32_char_hex_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Application ---------------------------------------------
ENVIRONMENT=development
DEBUG=true
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# ---- AI / LLM provider selection ----------------------------
# Set LLM_PROVIDER to "anthropic" or "openai"
LLM_PROVIDER=anthropic
# Override the model (leave blank to use each provider's default)
# Anthropic default: claude-sonnet-4-6
# OpenAI default:    gpt-4o
LLM_MODEL=

# ---- AI / Anthropic ------------------------------------------
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-change_me

# ---- AI / OpenAI ---------------------------------------------
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-change_me

# ---- AI observability (Langfuse — one provider only) ---------
LANGFUSE_PUBLIC_KEY=pk-lf-change_me
LANGFUSE_SECRET_KEY=sk-lf-change_me
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Sentry (leave blank to disable error reporting) ---------
SENTRY_DSN=

# ---- Versioning (overridden by DB at runtime, used in /version stub) --
DATA_VERSION=0
RULE_VERSION=0
CALCULATION_VERSION=0

# ---- Frontend (Vite picks up VITE_* vars only) ---------------
VITE_API_BASE_URL=http://localhost:8000
